{
  "name": "dsh-liuying-voice",
  "version": "0.1.7",
  "description": "流萤语音插件 for DeepSeek Harness：本地 edge-tts + RVC 音色转换，让 agent 用「流萤」的声音说话。开源 MIT；RVC 模型需用户自备。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "tts",
    "rvc",
    "voice",
    "liuying"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts/*.py",
    "scripts/*.mjs",
    "memory",
    "test",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bzg0211/dsh-liuying.git"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}